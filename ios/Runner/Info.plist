<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Same languages as lib/l10n: without this list iOS draws its own UI in the
	     app (the system paste button, share sheet, pickers) in English only. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>fr</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Docudis</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>docudis</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- No encryption of its own, only the system's HTTPS (ML Kit): App Store Connect stops asking about export compliance on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- image_picker: "Scan a photo" and picking an image. iOS kills the app without these. -->
	<key>NSCameraUsageDescription</key>
	<string>Docudis reads the text in the photo you take and anonymizes it on this iPhone. The photo never leaves the device.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Docudis reads the text in the image you choose and anonymizes it on this iPhone. The image never leaves the device.</string>
	<!-- AI apps probed via canOpenURL (lib/anonymize/ai_apps.dart). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>chatgpt</string>
		<string>claude</string>
		<string>googlegemini</string>
		<string>grok</string>
		<string>perplexity</string>
		<string>deepseek</string>
		<string>copilot</string>
		<string>kimi</string>
		<string>doubao</string>
		<string>tongyi</string>
		<string>mistral</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Google Sign-In: copy CLIENT_ID from GoogleService-Info.plist (see SETUP.md) -->
	<key>GIDClientID</key>
	<string>REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com</string>
	<!-- Google Sign-In: copy REVERSED_CLIENT_ID from GoogleService-Info.plist (see SETUP.md) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.REPLACE_WITH_REVERSED_CLIENT_ID</string>
			</array>
		</dict>
		<dict>
			<!-- Opened by the Share Extension after it saved a share (SharedInbox.swift). -->
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.stonetech.docudis.shared</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>docudis</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

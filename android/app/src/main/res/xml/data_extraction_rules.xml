<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same exclusions as backup_rules.xml for cloud backup and
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="records" />
        <exclude domain="file" path="dictionary.json" />
        <exclude domain="file" path="never_hide.json" />
        <exclude domain="file" path="models" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="records" />
        <exclude domain="file" path="dictionary.json" />
        <exclude domain="file" path="never_hide.json" />
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>
